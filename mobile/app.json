{
  "expo": {
    "name": "Dion",
    "slug": "dion",
    "version": "1.0.0",
    "scheme": "dion",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#151515",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.dion.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#151515",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "package": "app.dion.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": []
        }
      ],
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#151515"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
